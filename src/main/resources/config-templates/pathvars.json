[
  {
    "server": {
      "serverId": "pathvars-server",
      "port": 9001,
      "description": "Server with path variables and FreeMarker templates"
    },
    "expectations": [
      {
        "httpRequest": {
          "method": "GET",
          "path": "/users/{id}",
          "pathParameters": { "id": "[a-zA-Z0-9\\-]+" }
        },
        "httpResponse": {
          "statusCode": 200,
          "headers": [{ "name": "Content-Type", "values": ["application/json"] }],
          "body": "{\"userId\": \"${pathVariables.id}\", \"message\": \"User details\"}"
        }
      },
      {
        "httpRequest": {
          "method": "POST",
          "path": "/tasks"
        },
        "httpResponse": {
          "statusCode": 201,
          "headers": [{ "name": "Content-Type", "values": ["application/json"] }],
          "body": "{\"id\": \"task-123\", \"title\": \"${body.title}\", \"createdAt\": \"${.now?iso_utc}\"}"
        }
      }
    ]
  }
]
